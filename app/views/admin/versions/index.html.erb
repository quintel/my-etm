<%- content_for :menu_title, 'Model versions' %>
<%- content_for :title, 'Model versions' %>
<%= render(partial: "/admin/block_right_menu") %>

<div class="mt-10 text-midnight-400 text-sm">
  <%= "Current model versions (#{@versions.count})"%>
</div>
<div class="mt-2 border border-gray-200 rounded-md p-5">
  <% @versions.each do |version| %>
    <%= render Admin::VersionRow::Component.new(
      version: version
    )%>
  <% end %>
</div>
