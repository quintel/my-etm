<div class="flex items-center gap-5 w-full mt-5 p-2 pr-4 rounded-md hover:bg-midnight-600">
  <%# Name and tag %>
  <div class="flex flex-col w-24">
    <%= link_to @version.titleize, path, target: "_blank", rel: "noopener", class: "hover:underline" %>
    <span class="text-sm text-midnight-400">#<%= @version.tag %></span>
  </div>

  <%# Created %>
  <span class="w-44 text-midnight-400 text-sm">
    Created <%= time_ago_in_words(@version.created_at) %> ago
  </span>

  <%# URLs %>
  <span class="flex flex-col flex-1 text-midnight-400 text-sm">
    <div><%= @version.model_url %></div>
    <div><%= @version.collections_url %></div>
    <div><%= @version.engine_url %></div>
  </span>

  <%# Whether the version is offered in the apps' version pickers %>
  <div class="flex items-center gap-2 w-48 text-sm whitespace-nowrap">
    <span class="<%= @version.hidden ? 'text-midnight-400' : 'text-midnight-800 font-medium' %>">
      <%= t("admin.versions.status.#{@version.hidden ? 'hidden' : 'visible'}") %>
    </span>
    <% unless @version.default %>
      <%= button_to(
        t("admin.versions.#{@version.hidden ? 'show' : 'hide'}"),
        admin_version_path(@version),
        method: :patch,
        params: { version: { hidden: !@version.hidden } },
        class: button_classes("!py-1 text-sm", color: :gray)
      ) %>
    <% end %>
    <% if @version.deletable? %>
      <%= link_to(
        t("admin.versions.delete"),
        confirm_destroy_admin_version_path(@version),
        data: { turbo_frame: :modal },
        class: "text-red-600 hover:underline"
      ) %>
    <% end %>
  </div>
</div>
