<div class="row numbered mb-6">
  <label for="<%= @label_for %>" class="text-base text-sm text-midnight-400">
    <%= @title %>
  </label>

  <div class="mt-2">
    <%= content %>
  </div>

  <% if @hint.present? %>
    <p class="text-midnight-450 mt-2"><%= @hint %></p>
  <% end %>

  <%= after_hint %>
</div>
